# ---------------------------------------------------------------------------
# InterviewMate AI - server environment
# Copy this file to `.env` at the repository root and fill in your own key.
# The key is read ONLY by the Node/Express server. It is never bundled into
# the frontend and never sent to the browser.
# ---------------------------------------------------------------------------

# Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Gemini model used for question generation and answer evaluation.
# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# Port for the Express server. In production it also serves client/dist.
PORT=8787

# Optional: "true" makes the server return clearly-labelled simulated AI
# payloads. Use it only for local UI testing / automated tests. Never enable
# it in production - the UI shows a "Simulated" badge whenever it is active.
GEMINI_MOCK=false
